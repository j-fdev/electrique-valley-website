# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# Website addresses allowed to call the API (comma-separated, no trailing slash)
FRONTEND_URL=https://electriquevalley.com,https://www.electriquevalley.com
# Public address of this API, used to build the video links
BACKEND_URL=https://api.electriquevalley.com

# Gmail account that sends the contact and newsletter emails (use a Google app password)
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_LOGGING=false

# Optional: folder holding the converted .webm videos (default: src/uploads/convertedVideos)
# VIDEO_DIR=

# Signs the newsletter unsubscribe links (CASL). At least 32 random characters, keep it secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=
